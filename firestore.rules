rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Permitir acceso de lectura y escritura a la información del usuario solo si es el dueño de la cuenta.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección de productos
    match /products/{productId} {
      // Cualquiera (incluso usuarios no autenticados) puede leer los productos.
      allow read: if true;

      // Solo los usuarios autenticados con el claim 'admin' pueden escribir (crear, actualizar, borrar).
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
